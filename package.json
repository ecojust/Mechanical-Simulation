{
  "name": "mechanical-simulation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Mechanical assembly and verification workbench",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/*.test.ts",
    "desktop": "tauri dev",
    "desktop:pack": "tauri build --no-bundle",
    "assets:export": "blender -b --python scripts/export_assets.py && node scripts/index_asset_nodes.mjs",
    "test:e2e": "playwright test",
    "assets:verify": "node scripts/verify_assets.mjs",
    "verify:demo": "vite-node scripts/verify-demo.ts",
    "verify:bayonet": "vite-node scripts/verify-bayonet.ts",
    "release:mac": "bash scripts/build-macos-release.sh",
    "release:mac:verify": "bash scripts/verify-macos-release.sh",
    "release:mac:smoke": "node scripts/smoke-macos.mjs",
    "tauri": "tauri",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "mcp:test-protocol": "node scripts/test-mcp-protocol.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "author": "ecojust",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecojust/Mechanical-Simulation.git"
  }
}
