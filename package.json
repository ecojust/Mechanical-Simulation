{
  "name": "mechanical-simulation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Mechanical assembly and verification workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/*.test.ts",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "assets:export": "blender -b --python scripts/export_assets.py && node scripts/index_asset_nodes.mjs",
    "test:e2e": "playwright test",
    "assets:verify": "node scripts/verify_assets.mjs",
    "verify:demo": "vite-node scripts/verify-demo.ts",
    "verify:bayonet": "vite-node scripts/verify-bayonet.ts",
    "release:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "release:mac:verify": "bash scripts/verify-macos-release.sh",
    "release:mac:smoke": "node scripts/smoke-macos.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "@playwright/test": "^1.52.0"
  },
  "build": {
    "appId": "org.ecojust.mechanical-simulation",
    "productName": "Mechanical Studio",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Mechanical-Studio-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Mechanical Studio ${version} (Apple Silicon)",
      "sign": false
    }
  },
  "author": "ecojust",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecojust/Mechanical-Simulation.git"
  }
}
