  {
    "name": "import_component",
    "description": "Import a GLB/STL component with embedded base64 model, declared functional kind, dimensions and interaction parameters. Unconfigured components remain unverified. No filesystem paths or remote URLs are accepted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "component": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "description": "A kind returned by list_component_types."
            },
            "size": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "color": {
              "type": "string",
              "pattern": "^#[a-fA-F0-9]{6}$"
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "interaction": {
              "type": "object",
              "properties": {
                "version": {
                  "const": 1
                },
                "status": {
                  "enum": [
                    "configured",
                    "unconfigured"
                  ]
                },
                "axis": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "anchor": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "proxySize": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "mateFamily": {
                  "type": "string"
                },
                "insertionDepth": {
                  "type": "number"
                },
                "minClearance": {
                  "type": "number"
                },
                "lockAngle": {
                  "type": "number"
                }
              },
              "required": [
                "version",
                "status",
                "axis",
                "anchor",
                "proxySize"
              ],
              "additionalProperties": false,
              "description": "Declare local insertion axis, datum anchor and collision proxy in mm. Functional fields depend on list_component_types; missing values remain unverified."
            },
            "model": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "format": {
                  "enum": [
                    "glb",
                    "stl"
                  ]
                },
                "data": {
                  "type": "string",
                  "description": "Canonical base64, at most 12 MiB decoded; GLB must contain no external resources."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12582912
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "id",
                "name",
                "format",
                "data",
                "sha256",
                "bytes",
                "size",
                "center"
              ],
              "additionalProperties": false
            },
            "material": {
              "type": "object",
              "properties": {
                "metalness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "roughness": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "useSourceColor": {
                  "type": "boolean"
                }
              },
              "required": [
                "metalness",
                "roughness"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "id",
            "name",
            "kind",
            "size",
            "color",
            "params",
            "interaction",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expectedRevision",
        "component"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
