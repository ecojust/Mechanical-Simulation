      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "mechanism": {
          "type": "object",
          "properties": {
            "version": {
              "const": 1
            },
            "id": {
              "type": "string"
